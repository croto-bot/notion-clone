# Backend configuration for running OUTSIDE Docker (uv run ...).
# Copy to .env: cp .env.example .env
# Docker Compose does not read this file: the backend container gets its
# environment from docker-compose.yml and the root .env.

# Use localhost here: outside Compose there is no `db` hostname.
# User, password and database must match POSTGRES_* in the root .env.
DB_URL=postgresql://notion-clone:notion-clone@localhost:5432/notion-clone
DB_POOL_SIZE=100
DB_POOL_PRE_PING=false

APP_NAME=backend
ENVIRONMENT=local
DEBUG_MODE=false

LOG_LEVEL=INFO
LOG_FORMAT=console
# Level of uvicorn's non-access logger (startup, shutdown, WebSocket
# accepts): WARNING hides those lines, INFO shows them (the backend e2e
# stack runs INFO so the token-redaction test has lines to check).
# LOG_UVICORN_ERROR_LEVEL=WARNING

FRONTEND_URL=http://localhost:3000

# Optional integrations — leave empty to disable.
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9095/auth/oauth/google/callback
